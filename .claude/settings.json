{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin feature/*)",
      "Bash(git push -u origin epic/*)",
      "Bash(git push origin feature/*)",
      "Bash(git push origin epic/*)",
      "Bash(git worktree *)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(gh auth status*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr edit *)",
      "Bash(gh api repos/*/pulls/*)",
      "Bash(gh api repos/*/issues/*)",
      "Bash(gh label create *)",
      "Bash(gh label list*)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(bun install*)",
      "Bash(bun run *)",
      "Bash(bun test*)",
      "Bash(bun scripts/*)",
      "Bash(bunx tsc *)",
      "Bash(bunx biome *)",
      "Bash(docker compose up *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(mkdir -p *)",
      "Bash(.claude/pipeline/state.sh *)",
      "Bash(.claude/skills/watch-prs/precheck.sh*)",
      "Bash(.claude/pipeline/merge-sub-pr.sh *)",
      "Bash(gh issue create *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(git revert *)",
      "Bash(codegraph sync*)",
      "Bash(codegraph init*)",
      "Bash(codegraph explore*)",
      "Bash(bun --env-file=* run *)",
      "Bash(bun --env-file=* test*)",
      "Bash(jq *)",
      "WebSearch",
      "WebFetch",
      "mcp__codegraph__codegraph_explore"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push * main)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh api -X DELETE *)",
      "Bash(docker compose down -v*)",
      "Bash(rm -rf *)",
      "Bash(*db:reset*)",
      "Bash(docker volume rm*)",
      "Bash(git worktree remove --force*)",
      "Read(**/.env)",
      "Read(**/.env.*.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/spec-gate.sh",
            "timeout": 10,
            "statusMessage": "spec gate"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-ownership.sh",
            "timeout": 10,
            "statusMessage": "test ownership"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/biome-format.sh",
            "timeout": 30,
            "statusMessage": "biome"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck-on-stop.sh",
            "timeout": 180,
            "statusMessage": "typecheck changed packages"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/codegraph-sync.sh",
            "timeout": 30,
            "statusMessage": "codegraph"
          }
        ]
      }
    ]
  }
}
