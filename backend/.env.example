PORT=4000
APP_ORIGIN=http://localhost:3000
# Local Docker Postgres (docker compose service `postgres`)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/diecast
# Test DB for `bun test` (docker compose service postgres-test). Name must end in _test.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5433/diecast_test
ACCESS_TOKEN_SECRET=replace-with-long-random-string--oopeo
REFRESH_TOKEN_SECRET=replace-with-different-long-random-string-opopopo
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
