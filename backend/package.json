{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "bun test",
    "db:push": "bun drizzle-kit push",
    "db:reset": "bun scripts/db-reset.ts",
    "db:test:prepare": "bun scripts/prepare-test-db.ts",
    "seed": "bun scripts/seed-sco-demo.ts",
    "bootstrap-admin": "bun scripts/bootstrap-admin.ts",
    "contract:generate": "bun scripts/generate-api-manifest.ts",
    "contract:check": "bun scripts/generate-api-manifest.ts --check",
    "contract:query": "bun scripts/query-api-manifest.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "drizzle-orm": "^1.0.0-rc.5-5935859",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.9",
    "jose": "^6.2.3",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "latest",
    "drizzle-kit": "^1.0.0-rc.5-5935859",
    "typescript": "^5.9.2"
  }
}
